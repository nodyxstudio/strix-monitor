<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>StrixMonitor</AssemblyName>
    <RootNamespace>StrixMonitor</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>fr;en</SatelliteResourceLanguages>
    <Version>1.3.0</Version>
    <Product>Strix Monitor</Product><Company>Strix Monitor</Company><AssemblyTitle>Strix Monitor</AssemblyTitle>
    <!-- Moins de RAM : pas de thread GC en arrière-plan, et le bundle n'est pas décompressé en mémoire au lancement -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- Confidentialité : aucun chemin de la machine de compilation (nom d'utilisateur…) dans l'exe publié -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/src/StrixMonitor</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <Resource Include="owl.png" />
  </ItemGroup>
</Project>

